# Copy to scripts/cloud/cloud.env and edit (gitignored; contains secrets).
# sync_to_cloud.sh uploads it if present; coder-start reads it on the server.
# coder-start options (-k / -p / -m ...) override these; `--save` writes them back here.

# ---------------------------------------------------------------------------
# LLM: DeepSeek official OpenAI-compatible API (text-only, no image input)
# ---------------------------------------------------------------------------
CAPX_SERVER_URL=https://api.deepseek.com/v1/chat/completions
CAPX_MODEL=deepseek-v4-pro
CAPX_API_KEY=sk-your-deepseek-key
# CAPX_TEMPERATURE=1.0

# ---------------------------------------------------------------------------
# Task / Web UI
# ---------------------------------------------------------------------------
CAPX_CONFIG_PATH=env_configs/cube_stack/franka_robosuite_cube_stack.yaml
# Low-VRAM smoke (skips SAM3 + GraspNet):
# CAPX_CONFIG_PATH=env_configs/cube_stack/franka_robosuite_cube_stack_privileged.yaml

CAPX_WEB_UI_PORT=6006

# Shown to whoever logs in (banner / coder-start / coder-status).
# Public URL: leave empty when the instance has no public access (AutoDL personal).
CAPX_PUBLIC_URL=
# SSH target / password printed in the tunnel hint.
CAPX_SSH_ENDPOINT="-p 25446 root@connect.nmb2.seetacloud.com"
CAPX_SSH_PASSWORD=

# ---------------------------------------------------------------------------
# Paths on the server (defaults are relative to the synced repo root)
# ---------------------------------------------------------------------------
# SAM3_CHECKPOINT_PATH=/root/autodl-tmp/capx/models/sam3.pt
# ROBOT_DESCRIPTIONS_CACHE=/root/autodl-tmp/capx/robot_descriptions
