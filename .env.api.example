# Copy to .env.api.local. Do not commit real keys.
# Choose: deepseek / openai (chatgpt is an alias).
CAPX_LLM_BACKEND=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_SERVER_URL=https://api.deepseek.com/v1/chat/completions
# Retained from your selected model; editable for your account.
DEEPSEEK_MODEL=deepseek-v4-pro

OPENAI_API_KEY=
OPENAI_SERVER_URL=https://api.openai.com/v1/chat/completions
# Fill an API model ID available to your account, supporting Chat Completions.
OPENAI_MODEL=

CAPX_CLOUD_MAX_TOKENS=16384
