# Local env for code validation.
# Copy to project-root .env and edit:
#   cp .env.example .env
#
# Load before launch:
#   set -a && source .env && set +a
#   uv run --no-sync --active capx/envs/launch.py \
#     --config-path "$CAPX_CONFIG_PATH" \
#     --server-url "$CAPX_SERVER_URL" \
#     --model "$CAPX_MODEL" \
#     --api-key "${CAPX_API_KEY:-}" \
#     --web-ui True

# ---------------------------------------------------------------------------
# LLM backend: ollama | cloud
# ---------------------------------------------------------------------------
CAPX_LLM_BACKEND=ollama

# --- Mode A: local Ollama (default for host verification) ---
# Host: ollama serve && ollama pull qwen2.5-coder:7b
# Must listen on 127.0.0.1 (or 0.0.0.0).
CAPX_SERVER_URL=http://127.0.0.1:11434/v1/chat/completions
CAPX_MODEL=qwen2.5-coder:7b
CAPX_API_KEY=

# --- Mode B: cloud DeepSeek (OpenAI-compatible) ---
# CAPX_LLM_BACKEND=cloud
# CAPX_SERVER_URL=https://api.deepseek.com/v1/chat/completions
# CAPX_MODEL=deepseek-v4-pro
# CAPX_API_KEY=sk-your-deepseek-key
#
# Other OpenAI-compatible cloud (e.g. OpenRouter):
# CAPX_SERVER_URL=https://openrouter.ai/api/v1/chat/completions
# CAPX_MODEL=google/gemini-3.1-pro-preview
# CAPX_API_KEY=sk-or-v1-your-key-here
#
# Do NOT use model ids with an "openrouter/" prefix when calling the cloud URL
# directly — the client would rewrite them to a local proxy on :8110.

# ---------------------------------------------------------------------------
# Task / Web UI
# ---------------------------------------------------------------------------
CAPX_CONFIG_PATH=env_configs/cube_stack/franka_robosuite_cube_stack.yaml
# Low-VRAM smoke (skips SAM3 + GraspNet):
# CAPX_CONFIG_PATH=env_configs/cube_stack/franka_robosuite_cube_stack_privileged.yaml
CAPX_WEB_UI=True
CAPX_WEB_UI_PORT=8200
# CAPX_TEMPERATURE=1.0

# ---------------------------------------------------------------------------
# Optional local assets (leave unset to use library defaults / caches)
# ---------------------------------------------------------------------------
# SAM3 — ModelScope cache example (adjust if your path differs):
# SAM3_CHECKPOINT_PATH=${HOME}/.cache/modelscope/models/facebook--sam3/snapshots/master/sam3.pt
# CAPX_SAM3_CHECKPOINT=${SAM3_CHECKPOINT_PATH}
# HF_TOKEN=hf_...
#
# Panda URDF — only if you need a fixed local path:
# CAPX_PANDA_URDF_PATH=${HOME}/.cache/robot_descriptions/example-robot-data/robots/panda_description/urdf/panda.urdf
# ROBOT_DESCRIPTIONS_CACHE=${HOME}/.cache/robot_descriptions
