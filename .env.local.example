# Copy to .env.local at the project root. Never commit real keys.
# The local Ollama/vLLM backends require no key.
CAPX_CLOUD_SERVER_URL='https://api.deepseek.com/chat/completions'
CAPX_CLOUD_MODEL='deepseek-v4-pro'
CAPX_CLOUD_API_KEY=''
# For OpenRouter, save the key separately in .openrouterkey.
CAPX_OPENROUTER_MODEL='google/gemini-3.1-pro-preview'
CAPX_LLM_BACKEND='cloud'
CAPX_CLOUD_MAX_TOKENS='16384'
